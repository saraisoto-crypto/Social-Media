<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Social Media - Feed</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('partials/sidebar') %>
  <main class="main">
    <div class="content">
      <div class="page-head fade-in">
        <h1>El feed</h1>
        <a href="/posts/new" class="btn">+ Nuevo post</a>
      </div>

      <% if (posts.length === 0) { %>
        <div class="empty-state fade-in">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="3"/><path d="M8 12h8M8 16h5"/></svg>
          <p>Todavía no hay posts. ¡Sé la primera en publicar algo!</p>
          <a href="/posts/new" class="btn">Crear el primero</a>
        </div>
      <% } else { %>
        <div class="feed-grid">
          <% posts.forEach(post => { %>
            <article class="entry fade-in">
              <div class="entry-byline">
                <span class="avatar"><%= post.user ? post.user.name.charAt(0) + post.user.lastName.charAt(0) : "?" %></span>
                <span><%= post.user ? post.user.name + " " + post.user.lastName : "Desconocido" %></span>
              </div>
              <h2 class="entry-title"><%= post.title %></h2>
              <% if (post.imageUrl) { %>
                <img class="entry-photo" src="<%= post.imageUrl %>" alt="Imagen del post">
              <% } %>
              <p class="entry-content"><%= post.content %></p>
              <div class="entry-tags">
                <% (post.hashtags || []).forEach(tag => { %>
                  <span class="tag">#<%= tag %></span>
                <% }) %>
              </div>
              <div class="entry-actions">
                <a href="/posts/<%= post._id %>/edit" class="icon-btn" title="Editar">
                  <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 013 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
                </a>
                <form action="/posts/<%= post._id %>/delete" method="POST">
                  <button type="submit" class="icon-btn" title="Eliminar">
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4a1 1 0 011-1h4a1 1 0 011 1v2"/></svg>
                  </button>
                </form>
              </div>
            </article>
          <% }) %>
        </div>
      <% } %>
    </div>
  </main>
</body>
</html>